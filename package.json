{
  "name": "weighthelper-root",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "server/admin-dashboard"
  ],
  "scripts": {
    "bootstrap": "npm install && npm run install:all",
    "install:all": "npm install --prefix client && npm install --prefix server && npm install --prefix server/admin-dashboard",
    "build": "npm run build --prefix client && npm run build --prefix server/admin-dashboard",
    "start": "npm run start --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "test:regression": "node scripts/test-api-regressions.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
